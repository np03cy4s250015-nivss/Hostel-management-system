# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hostel_management

# Security - generate a strong random secret
JWT_SECRET=your-secure-secret-here

# Server Port
PORT=3000

# Backend base URL (for payment callbacks)
# Override for production: BACKEND_BASE_URL=https://your-domain.com
BACKEND_BASE_URL=http://127.0.0.1:3000

# Database SSL (set to "true" for production)
DB_SSL=false

# eSewa Payment Gateway (Sandbox)
ESEWA_MERCHANT_CODE=EPAYTEST
# Get your secret key from eSewa merchant dashboard
ESEWA_SECRET_KEY=your-esewa-secret-key-here
FRONTEND_URL=http://127.0.0.1:5500/frontend